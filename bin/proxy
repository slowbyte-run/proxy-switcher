#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
helper="$script_dir/../libexec/proxy_helper.py"

usage() {
  cat <<'EOF'
Usage: proxy <command> [options]

Commands:
  status [--json]   Show the state of every proxy carrier

Options:
  -h, --help        Show this help
EOF
}

subcommand="${1-}"
if (( $# > 0 )); then
  shift
fi

case "$subcommand" in
  status)
    exec python3 -B "$helper" status "$@"
    ;;
  -h | --help | help)
    usage
    exit 0
    ;;
  "")
    usage >&2
    exit 2
    ;;
  *)
    printf 'proxy: unknown command: %s\n' "$subcommand" >&2
    usage >&2
    exit 2
    ;;
esac
