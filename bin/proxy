#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
helper="$script_dir/../libexec/proxy_helper.py"
engine="$script_dir/../libexec/proxy_engine.py"

usage() {
  cat <<'EOF'
Usage: proxy <command> [options] [carrier...]

Commands:
  on [carrier...]    Turn managed carriers on (default: every managed carrier)
  off [carrier...]   Turn managed carriers off
  status [--json]    Show the state of every proxy carrier

Options for on/off:
  --force            Overwrite a file that changed since the last switch
  --dry-run          Show what would change without writing
  --proxy <url>      Override the configured proxy endpoint
  -v, --verbose      Explain what was done

Options:
  -h, --help        Show this help

Exit status: 0 success, 1 conflict/failure, 2 usage error.
EOF
}

# Accept on/off options before the command as well as after it. This keeps
# `proxy --proxy URL on niri` working without a second option parser.
global_options=()
while (( $# > 0 )); do
  case "$1" in
    --proxy)
      if (( $# < 2 )); then
        printf 'proxy: --proxy requires an argument\n' >&2
        exit 2
      fi
      global_options+=("$1" "$2")
      shift 2
      ;;
    --force | --dry-run | -v | --verbose)
      global_options+=("$1")
      shift
      ;;
    *)
      break
      ;;
  esac
done

subcommand="${1-}"
if (( $# > 0 )); then
  shift
fi

case "$subcommand" in
  on | off)
    exec python3 -B "$engine" "$subcommand" "${global_options[@]}" "$@"
    ;;
  status)
    if (( ${#global_options[@]} > 0 )); then
      printf 'proxy: options before the command are not valid for status\n' >&2
      exit 2
    fi
    exec python3 -B "$helper" status "$@"
    ;;
  -h | --help | help)
    usage
    exit 0
    ;;
  "")
    usage >&2
    exit 2
    ;;
  *)
    printf 'proxy: unknown command: %s\n' "$subcommand" >&2
    usage >&2
    exit 2
    ;;
esac
